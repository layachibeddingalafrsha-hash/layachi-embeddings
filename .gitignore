 # Git ignore for website-crocco
 # Purpose: sensible defaults for web projects (Node, Python), Windows, and common editors/IDEs.

 # Node
 /node_modules/
 
 # Next.js
 /.next/
 .next/
 /out/
 /npm-debug.log*
 /yarn-debug.log*
 /yarn-error.log*
 /pnpm-debug.log*
 /.pnp/
 .pnp.js

 # Build outputs
 /dist/
 /build/
 /out/
 /.parcel-cache/
 /.next/
 /.nuxt/

 # Static site generators
 /public/build/

 # Python
 __pycache__/
 *.py[cod]
 *.pyo
 *.pyd
 *.pyc
 *.pyd
 .Python
 venv/
 .venv/
 ENV/
 env/
 .env
 .env.*.local
 .env.local
 .env.production
 .env.vercel

 # Tests / coverage
 /coverage/
 .coverage
 coverage.xml

 # IDEs and editors
 .vscode/
 .idea/
 *.sublime-workspace
 *.sublime-project

 # OS generated files
 .DS_Store
 Thumbs.db
 ehthumbs.db
 Desktop.ini
 $RECYCLE.BIN/

 # Logs
 logs
 *.log
 npm-debug.log*
 yarn-debug.log*

 # Misc
 *.tmp
 *.local

 # Lockfiles: keep by default (commit lockfiles unless the project owner says otherwise)
 # package-lock.json
 # yarn.lock
 # pnpm-lock.yaml
node_modules
.next

# Environment / secrets
.env
.env.*
!.env.example
!.env.template

# Vercel
.vercel/

# Dependencies
node_modules/

# Build / cache
.next/
dist/
build/
.cache/
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/


env.txt